<Window x:Class="OpenVpnClientManager.Views.CredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Style.Window}"
        Title="Inloggegevens" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Eyebrow" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,4" />
        <TextBlock x:Name="TitleText" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />
        <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,14" />

        <Border x:Name="FailedBanner" Style="{StaticResource Style.DangerBanner}" Margin="0,0,0,14" Visibility="Collapsed">
            <TextBlock Text="De vorige poging is geweigerd door de server. Controleer de gegevens." Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
        </Border>

        <StackPanel x:Name="UsernamePanel">
            <TextBlock Text="Gebruikersnaam" Style="{StaticResource Text.Muted}" Margin="0,0,0,6" />
            <TextBox x:Name="UsernameBox" Style="{StaticResource Style.TextBox}" MaxLength="512" />
        </StackPanel>

        <TextBlock x:Name="PasswordLabel" Text="Wachtwoord" Style="{StaticResource Text.Muted}" Margin="0,14,0,6" />
        <PasswordBox x:Name="PasswordBox" Style="{StaticResource Style.PasswordBox}" MaxLength="512" />

        <StackPanel x:Name="ChallengePanel" Visibility="Collapsed">
            <TextBlock x:Name="ChallengeLabel" Style="{StaticResource Text.Muted}" Margin="0,14,0,6" TextWrapping="Wrap" />
            <TextBox x:Name="ChallengeBox" Style="{StaticResource Style.TextBox}" MaxLength="512" />
            <PasswordBox x:Name="ChallengeSecretBox" Style="{StaticResource Style.PasswordBox}" MaxLength="512" Visibility="Collapsed" />
        </StackPanel>

        <CheckBox x:Name="RememberBox" Style="{StaticResource Style.CheckBox}" Margin="0,16,0,0"
                  Content="Onthouden (versleuteld met Windows DPAPI voor dit gebruikersaccount)" />
        <TextBlock x:Name="RememberHint" Style="{StaticResource Text.Dim}" Margin="26,4,0,0" TextWrapping="Wrap"
                   Text="Eenmalige codes (2FA) worden nooit opgeslagen." Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource Style.Button}" Content="Annuleren" IsCancel="True" Margin="0,0,8,0" MinWidth="96" />
            <Button x:Name="OkButton" Style="{StaticResource Style.PrimaryButton}" Content="Verbinden" IsDefault="True" MinWidth="110" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
