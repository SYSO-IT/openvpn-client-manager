<Window x:Class="OpenVpnClientManager.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Style.Window}"
        Title="Log" Width="820" Height="520" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="Eyebrow" Style="{StaticResource Text.Eyebrow}" />
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.H2}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="FollowBox" Style="{StaticResource Style.CheckBox}" Content="Volgen" IsChecked="True" Margin="0,0,16,0" />
                <Button Style="{StaticResource Style.Button}" Content="Bestand openen" Click="OnOpenFile" Margin="0,0,8,0" />
                <Button Style="{StaticResource Style.Button}" Content="Kopiëren" Click="OnCopy" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Style.Card}" Padding="0" Background="{DynamicResource Brush.Input}">
            <ListBox x:Name="List" Style="{StaticResource Style.ListBox}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionMode="Extended" Padding="8">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.ListBoxItem}">
                        <Setter Property="Padding" Value="6,1" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="None" Foreground="{DynamicResource Brush.TextMuted}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="2" x:Name="PathText" Style="{StaticResource Text.Dim}" Margin="0,8,0,0" />
    </Grid>
</Window>
