<Window x:Class="OpenVpnClientManager.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Style.Window}"
        Title="Exporteren" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Configuratie exporteren" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />
        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Maakt één bundel met de geselecteerde klanten, hun sites en de bijbehorende OpenVPN-configs (inclusief certificaten en sleutels)." />

        <Grid Margin="0,0,0,6">
            <TextBlock Text="Klanten" Style="{StaticResource Text.Eyebrow}" VerticalAlignment="Center" />
            <CheckBox x:Name="SelectAllBox" Style="{StaticResource Style.CheckBox}" Content="Alles" HorizontalAlignment="Right" IsChecked="True" Click="OnSelectAll" />
        </Grid>
        <Border Style="{StaticResource Style.Card}" Padding="8" MaxHeight="220">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CustomerList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource Style.CheckBox}" IsChecked="{Binding Selected, Mode=TwoWay}" Margin="4,4" Click="OnItemClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text}" />
                                    <TextBlock Text="{Binding SiteLabel}" Style="{StaticResource Text.Dim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Text="Beveiliging" Style="{StaticResource Text.Eyebrow}" Margin="0,16,0,8" />
        <CheckBox x:Name="EncryptBox" Style="{StaticResource Style.CheckBox}" Content="Bundel versleutelen met een wachtwoordzin (AES-256-GCM)" IsChecked="True" Click="OnEncryptChanged" />
        <Grid x:Name="PassphrasePanel" Margin="26,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Wachtwoordzin" Style="{StaticResource Text.Muted}" Margin="0,0,0,6" />
                <PasswordBox x:Name="PassBox" Style="{StaticResource Style.PasswordBox}" PasswordChanged="OnPassChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Herhaal" Style="{StaticResource Text.Muted}" Margin="0,0,0,6" />
                <PasswordBox x:Name="PassBox2" Style="{StaticResource Style.PasswordBox}" PasswordChanged="OnPassChanged" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="PassHint" Style="{StaticResource Text.Dim}" Margin="26,6,0,0" Text="Minimaal 12 tekens." />

        <CheckBox x:Name="CredentialsBox" Style="{StaticResource Style.CheckBox}" Margin="0,12,0,0"
                  Content="Opgeslagen inloggegevens meenemen (alleen mogelijk in een versleutelde bundel)" />

        <Border x:Name="PlainWarning" Style="{StaticResource Style.WarningBanner}" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"
                       Text="Een onversleutelde bundel bevat privésleutels en certificaten in leesbare vorm. Bewaar en verstuur deze alleen via een beveiligd kanaal." />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource Style.Button}" Content="Annuleren" IsCancel="True" Margin="0,0,8,0" MinWidth="96" />
            <Button x:Name="OkButton" Style="{StaticResource Style.PrimaryButton}" Content="Exporteren…" IsDefault="True" MinWidth="120" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
